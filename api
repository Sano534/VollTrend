const BOT_TOKEN = process.env.BOT_TOKEN;

const MINI_APP_URL = "https://voll-trend.vercel.app";

const FIREBASE_URL =
  "https://volltrend-33497-default-rtdb.europe-west1.firebasedatabase.app";

const TRAINING_ID = "30-08-2026";
const MAX_PLACES = 12;
const PRICE = 400;

const BOOKINGS_URL =
  `${FIREBASE_URL}/trainings/${TRAINING_ID}/bookings.json`;

function menuKeyboard() {
  return {
    inline_keyboard: [
      [
        {
          text: "👥 Список записавшихся",
          callback_data: "show_bookings"
        }
      ],
      [
        {
          text: "🏐 Открыть приложение",
          web_app: {
            url: MINI_APP_URL
          }
        }
      ]
    ]
  };
}

function backKeyboard() {
  return {
    inline_keyboard: [
      [
        {
          text: "⬅️ Назад в меню",
          callback_data: "back_to_menu"
        }
      ]
    ]
  };
}

async function telegram(method, body) {
  const response = await fetch(
    `https://api.telegram.org/bot${BOT_TOKEN}/${method}`,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(body)
    }
  );

  return response.json();
}

async function getBookings() {
  const response = await fetch(BOOKINGS_URL);

  if (!response.ok) {
    throw new Error("Не удалось получить данные Firebase");
  }

  const data = await response.json();

  if (!data || typeof data !== "object") {
    return [];
  }

  return Object.values(data)
    .filter((booking) => booking && booking.username)
    .sort((a, b) => {
      const first = Number(a.createdAt || 0);
      const second = Number(b.createdAt || 0);

      return first - second;
    });
}

function getBookingsText(bookings) {
  const booked = bookings.filter(
    (booking) => booking.status === "booked"
  );

  const waitlist = bookings.filter(
    (booking) => booking.status === "waitlist"
  );

  let text =
    "🏐 <b>VollTrend</b>\n\n" +
    "📅 <b>Тренировка:</b> 30 августа 2026\n" +
    "🕗 <b>Время:</b> 20:00\n" +
    "📍 <b>Место:</b> ГТС\n" +
    `💰 <b>Стоимость:</b> ${PRICE} ₽\n\n`;

  text += `👥 <b>Основной список:</b> ${booked.length}/${MAX_PLACES}\n\n`;

  if (booked.length === 0) {
    text += "Пока никто не записался.\n";
  } else {
    booked.forEach((booking, index) => {
      const paidMark = booking.paid === true ? " ✅" : "";

      text += `${index + 1}. ${escapeHtml(
        formatUsername(booking)
      )}${paidMark}\n`;
    });
  }

  text += "\n";

  if (waitlist.length > 0) {
    text += `⏳ <b>Очередь:</b> ${waitlist.length}\n\n`;

    waitlist.forEach((booking, index) => {
      const paidMark = booking.paid === true ? " ✅" : "";

      text += `${index + 1}. ${escapeHtml(
        formatUsername(booking)
      )}${paidMark}\n`;
    });
  }

  text +=
    "\n✅ — оплата подтверждена\n" +
    "Без отметки — оплата ещё не подтверждена.";

  return text;
}

function formatUsername(booking) {
  if (booking.username) {
    return booking.username.startsWith("@")
      ? booking.username
      : `@${booking.username}`;
  }

  if (booking.firstName) {
    return booking.firstName;
  }

  return "Пользователь";
}

function escapeHtml(value) {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

async function showMenu(chatId, messageId = null) {
  const text =
    "🏐 <b>VollTrend</b>\n\n" +
    "Выбери действие:";

  if (messageId) {
    return telegram("editMessageText", {
      chat_id: chatId,
      message_id: messageId,
      text,
      parse_mode: "HTML",
      reply_markup: menuKeyboard()
    });
  }

  return telegram("sendMessage", {
    chat_id: chatId,
    text,
    parse_mode: "HTML",
    reply_markup: menuKeyboard()
  });
}

async function showBookings(chatId, messageId = null) {
  const bookings = await getBookings();
  const text = getBookingsText(bookings);

  if (messageId) {
    return telegram("editMessageText", {
      chat_id: chatId,
      message_id: messageId,
      text,
      parse_mode: "HTML",
      reply_markup: backKeyboard()
    });
  }

  return telegram("sendMessage", {
    chat_id: chatId,
    text,
    parse_mode: "HTML",
    reply_markup: backKeyboard()
  });
}

export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(200).json({
      ok: true,
      message: "VollTrend bot is working"
    });
  }

  try {
    if (!BOT_TOKEN) {
      console.error("BOT_TOKEN не найден в Environment Variables");

      return res.status(500).json({
        ok: false,
        error: "BOT_TOKEN is missing"
      });
    }

    const update = req.body;

    if (update.message) {
      const message = update.message;
      const chatId = message.chat.id;
      const text = message.text || "";

      if (text === "/start" || text === "/menu") {
        await showMenu(chatId);
      }

      return res.status(200).json({
        ok: true
      });
    }

    if (update.callback_query) {
      const callback = update.callback_query;
      const callbackId = callback.id;
      const chatId = callback.message.chat.id;
      const messageId = callback.message.message_id;
      const action = callback.data;

      await telegram("answerCallbackQuery", {
        callback_query_id: callbackId
      });

      if (action === "show_bookings") {
        try {
          await showBookings(chatId, messageId);
        } catch (error) {
          console.error("Ошибка получения списка:", error);

          await telegram("editMessageText", {
            chat_id: chatId,
            message_id: messageId,
            text:
              "❌ Не удалось загрузить список записавшихся.\n\n" +
              "Попробуй ещё раз позже.",
            reply_markup: backKeyboard()
          });
        }
      }

      if (action === "back_to_menu") {
        await showMenu(chatId, messageId);
      }

      return res.status(200).json({
        ok: true
      });
    }

    return res.status(200).json({
      ok: true
    });
  } catch (error) {
    console.error("BOT ERROR:", error);

    return res.status(200).json({
      ok: false,
      error: error.message
    });
  }
}